# Cấu hình Môi trường Production cho Zalo Auto SaaS

# ================================
# Database & Cache
# ================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_super_secure_postgres_password_here
POSTGRES_DB=zalo_auto

# Nếu chạy Docker Compose nội bộ: postgres://...
DATABASE_URL=postgresql://postgres:your_super_secure_postgres_password_here@localhost:5432/zalo_auto?schema=public
REDIS_URL=redis://localhost:6379

# ================================
# Security Secrets
# ================================
# Chuỗi JWT bí mật (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=replace_with_a_random_jwt_secret_min_32_characters_123456789

# Khóa mã hóa session Zalo AES-256-GCM (chính xác 64 ký tự hex = 32 bytes)
# Tạo bằng: openssl rand -hex 32
SESSION_SECRET_KEY=replace_with_64_char_hex_key_generated_by_openssl_rand_hex_32

# ================================
# Domain & URLs
# ================================
PORT=4001
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXT_PUBLIC_SOCKET_URL=https://yourdomain.com

# ================================
# SePay Payment Gateway
# ================================
SEPAY_API_KEY=your_sepay_api_token
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=9999999999
SEPAY_ACCOUNT_HOLDER=CONG TY CONG NGHE
